{
  "name": "portcall",
  "type": "module",
  "version": "0.3.0",
  "packageManager": "pnpm@12.21.0",
  "description": "Run your local dev servers in the background, on fixed ports, with logs your coding agents can read",
  "author": "Joris Gallot",
  "license": "MIT",
  "homepage": "https://github.com/joris-gallot/portcall#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joris-gallot/portcall.git"
  },
  "bugs": "https://github.com/joris-gallot/portcall/issues",
  "keywords": [
    "dev-server",
    "ports",
    "process-manager",
    "logs",
    "agents",
    "cli"
  ],
  "bin": {
    "portcall": "./dist/portcall.mjs"
  },
  "files": [
    "dist",
    "schema.json"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "prepublishOnly": "tsdown",
    "schema": "node scripts/schema.ts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "tsdown": "^0.23.7",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
